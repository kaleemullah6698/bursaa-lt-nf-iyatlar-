# ==============================================================================
# Bursa Gold Price Automated Collector - Environment Configuration
# ==============================================================================

# Node Environment ('production' | 'development')
NODE_ENV=production

# Server Port for Internal API and Health Endpoints
COLLECTOR_PORT=4000

# Collection interval in seconds (300 = 5 minutes, 900 = 15 minutes, 1800 = 30 minutes)
COLLECTOR_INTERVAL_SECONDS=300

# PostgreSQL Connection String
# Leave empty to use embedded in-memory database during local testing
DATABASE_URL=postgresql://bursa_user:secure_gold_password_change_me@localhost:5432/bursa_gold_db

# Primary Free Public API Endpoint
PRIMARY_SOURCE_URL=https://static.altinkaynak.com/public/Gold

# Secondary Fallback Endpoint
FALLBACK_SOURCE_URL=https://finans.truncgil.com/v4/today.json

# Maximum retry attempts per cycle
MAX_RETRIES=3

# Initial exponential backoff delay in milliseconds
RETRY_DELAY_MS=2000
